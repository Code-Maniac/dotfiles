# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# export useful infomation
export DOTFILES=~/.dotfiles
# zsh path information
export ZSHRC=${DOTFILES}/zsh/zshrc
# tmux path information
export TMUXRC=${DOTFILES}/tmux/tmux.conf
# kitty path information
export KITTYRC=${DOTFILES}/kitty/kitty.conf

# docker does not forward COLORTERM into a container, so nvim sees no truecolor
# support, leaves termguicolors off, and a truecolor theme like astrodark gets
# approximated onto the 256 colour cube. The terminal on the far end is still
# the host's, which is truecolor, so say so.
#
# TERM is deliberately left alone. Nothing in here can tell whether the outer
# terminal is tmux, and guessing xterm-256color when it is screen-256color makes
# programs emit sequences tmux does not advertise. Forward it from the host
# instead: docker exec -e TERM -e COLORTERM ...
if [[ -n ${SDKZ_IMAGE_VERSION:-} ]]; then
  export COLORTERM=${COLORTERM:-truecolor}
fi

# get a path file based on the OSTYPE
if [[ ${OSTYPE} == 'darwin'* ]]; then
  PATH_APPEND='darwin'
elif grep -q microsoft /proc/version &> /dev/null; then
  PATH_APPEND='linux-wsl'
else
  PATH_APPEND=${OSTYPE}
fi

# Drop any empty element inherited from the parent environment. An empty PATH
# entry means "current directory", and it propagates into every child process,
# so a shell started before this was fixed can keep handing it down for days.
path=(${path:#})

export PATHFILE=${DOTFILES}/zsh/path-${PATH_APPEND}
if [ -r "${PATHFILE}" ]; then
  # Append each line of the path file to $path, skipping comments and blanks.
  # ${(f)...} splits the file on newlines; the quotes matter, as they keep
  # entries containing spaces intact and yield an empty array (not a single
  # empty element) when the file has nothing in it. Appending to the $path
  # array rather than the $PATH string is what avoids a stray ':' — an empty
  # PATH element means "current directory", which is not something we want.
  path+=(${(f)"$(grep -vE '^[[:space:]]*(#|$)' ${PATHFILE})"})
fi

# Add brew library path
if [[ ${OSTYPE} == 'darwin'* ]]; then
  PATH_APPEND='darwin'
  export LIBRARY_PATH="$LIBRARY_PATH:$(brew --prefix)/lib"
fi

# enable autojump if debian based (otherwise enabled automatically)
if [ -f "/etc/debian_version" ]; then
  source /usr/share/autojump/autojump.sh
fi

# add completions
# must come before antigen, which runs the only compinit (in `antigen apply`)
FPATH=$HOME/.docker/completions:$FPATH
# drop `_<command>` files in here for anything else (e.g. _west)
FPATH=$HOME/.zsh/completions:$FPATH
# zsh-users/zsh-completions submodule
FPATH=$DOTFILES/zsh/zsh-completions/src:$FPATH

# load plugin manager and oh-my-zsh
source ~/.antigen/antigen.zsh
antigen use oh-my-zsh

# theme
antigen theme romkatv/powerlevel10k

# plugins
antigen bundle python
# antigen bundle rust
antigen bundle golang
# antigen bundle docker
antigen bundle history
antigen bundle sudo
antigen bundle man

# get zsh-syntax-highlighting plugin
antigen bundle zsh-users/zsh-syntax-highlighting

# antigen is finished
antigen apply

# antigen zcompiles its compdump in a detached background job, so .zcompdump.zwc
# can end up holding stale contents without being older than .zcompdump. zsh then
# loads the stale compiled copy and newly added completions never show up until
# you run compinit by hand. Bin the .zwc unless it's genuinely newer.
if [[ -f ~/.antigen/.zcompdump.zwc && ! ~/.antigen/.zcompdump.zwc -nt ~/.antigen/.zcompdump ]]; then
  rm -f ~/.antigen/.zcompdump.zwc
fi

# if on mac add an alias for nproc
if [[ ${OSTYPE} == 'darwin'* ]]; then
  alias nproc="sysctl -n hw.ncpu"
fi

# rsync-backed copy. Deliberately NOT called `cp` — rsync differs on trailing
# slashes and `-a` preserves timestamps, so shadowing cp makes pasted commands
# behave differently to how they read.
if hash rsync &> /dev/null
then
    alias cpr="rsync -avz"
fi

if hash rg &> /dev/null
then
    alias ripgrep="rg"
fi

# if nvim is installed then use it instead of vim
if hash nvim &> /dev/null
then
    NVIM="nvim"
    alias vi=${NVIM}
    alias vim=${NVIM}

    # Add nvimdev alias for making it easier to develop an nvim plugin
    # Opens nvim with the current directory added to the runtime path
    alias nvimdev="${NVIM} --cmd \"set rtp+=$(pwd)\""

    # set nvim to the default editor
    export EDITOR=${NVIM}
    export VISUAL=${NVIM}

    # add alias nvimdiff to be consistent with vimdiff
    alias nvimdiff="nvim -d"
    # short form. `diff` itself is left alone so it keeps behaving like the
    # POSIX tool that scripts and pasted commands expect.
    alias vdiff="nvimdiff"
fi

# if python3 is called via python3 then alias python to call python3
if hash python3 &> /dev/null
then
  alias python="python3"
fi

# if vimcat is installed then add ccat alias
if hash vimcat &> /dev/null
then
  alias ccat="vimcat"
fi

# add "copy" command if xclip is installed which copies to clipboard
if hash xclip &> /dev/null
then
  alias copy="xclip -selection clipboard"
fi

# if I'm on WSL then I'm probably at work so add script to get
# the compile commands json from windows cmake projects and replace C:/ with
# /mnt/c
if grep -q microsoft /proc/version &> /dev/null; then
  # run within root of project to bring it in
  function funcgetcc() {
    file=$(find . -type f -name "compile_commands.json" -print -quit)
    sed -i "s/C\:/\/mnt\/c/g" ${file} &> /dev/null
    cp ${file} . &> /dev/null
  }
  alias getcc="funcgetcc"
fi

# Add alias for kitty to make sure it starts maximized
alias kitty="kitty --start-as maximized"

# add p command
# attempt to change directory within ~/projects
function p() {
  cd ~/projects/$1
}

# if clang-format is installed then add command clangfmt (similar to rustfmt)
# clangfmt uses the ~/.config/clangfmt/clang-format file as config
if hash clang-format &> /dev/null; then
  function funcclangfmt() {
    # for each cpp/c filetype run clangfmt
    files=$(find . -type f -iname "*.cpp" -o -iname "*.hpp" -o -iname "*.c" -o -iname "*.h")
    if [ ! -z "${files}" ]; then
      echo ${files} | xargs clang-format -i
    else
      echo "No source files found"
    fi
  }
  alias clangfmt="funcclangfmt"
fi

# add bitbake, recipetool and devtool alias'
alias bb="bitbake"
alias bbl="bitbake-layers"
alias rp="recipetool"
alias dt="devtool"

# for accidental vim commands in terminal
alias :q='echo You are not editing a file, dummy'
alias :wq='echo You are not editing a file, dummy'

# colored man pages
export LESS_TERMCAP_mb=$'\e[1;32m'
export LESS_TERMCAP_md=$'\e[1;32m'
export LESS_TERMCAP_me=$'\e[0m'
export LESS_TERMCAP_se=$'\e[0m'
export LESS_TERMCAP_so=$'\e[01;33m'
export LESS_TERMCAP_ue=$'\e[0m'
export LESS_TERMCAP_us=$'\e[1;4;31m'

# add fzf into the mix
[[ ! -f ${DOTFILES}/zsh/fzf.zsh ]] || source ${DOTFILES}/zsh/fzf.zsh

# venv / venv-new helpers for ~/.venvs (completion in zsh/completions/_venv)
[[ ! -f ${DOTFILES}/zsh/venv.zsh ]] || source ${DOTFILES}/zsh/venv.zsh

# docker wrapper that forwards TERM/COLORTERM into containers
[[ ! -f ${DOTFILES}/zsh/docker.zsh ]] || source ${DOTFILES}/zsh/docker.zsh

# SDKZ container helpers - vtbuild and friends (completion in zsh/completions)
if [[ -n ${SDKZ_IMAGE_VERSION:-} && -f ${DOTFILES}/zsh/vt.zsh ]]; then
  source ${DOTFILES}/zsh/vt.zsh
fi

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# ~/.p10k.zsh is generated per machine and is not tracked in here, so container
# specific prompt changes go in as overrides after it has been sourced.
#
# The os_icon slot shows ubuntu inside the SDKZ image and fedora outside it,
# which is too subtle to notice at a glance. Swap it for a docker whale on red -
# same slot, no layout change, and the only red block in an otherwise grey
# prompt.
if [[ -n ${SDKZ_IMAGE_VERSION:-} ]]; then
  typeset -g POWERLEVEL9K_OS_ICON_CONTENT_EXPANSION=$''  # nf-linux-docker
  typeset -g POWERLEVEL9K_OS_ICON_FOREGROUND=255
  typeset -g POWERLEVEL9K_OS_ICON_BACKGROUND=1
fi

# if we are in home then change to windows home
if grep -q microsoft /proc/version &> /dev/null; then
  if [[ $PWD = $HOME ]]; then
    # change this to prompt
    cd /mnt/c/Users/jayco
  fi
fi

# finally if we are not in tmux session then make a new one
# if [ "$DOCKERIMAGE" = "" ] && [ "$TMUX" = "" ]; then tmux attach || tmux new; fi

# add exit so if anything gets auto appended then it's ignored
return
