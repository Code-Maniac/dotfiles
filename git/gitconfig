[init]
	defaultBranch = master
[core]
	editor = nvim
	excludesfile = ~/.gitignore_global
[merge]
	tool = nvimdiff
	conflictstyle = diff3
[mergetool]
	prompt = false
[diff]
	tool = nvimdiff
[difftool]
	prompt = true
[difftool "nvimdiff"]
	cmd = nvim -f -d -c \"wincmd l\" -c 'cd \"$GIT_PREFIX\"' \"$LOCAL\" \"$REMOTE\"
[alias]
	d = difftool
	whatadded = log --diff-filter=A --
	l = log --graph
	lgb = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset%n' --abbrev-commit --date=relative --branches
	fl = log --oneline --graph --all --decorate --abbrev-commit
[mergetool "vim-conflicted"]
	cmd = nvim +Conflicted
[user]
	name = Nick Jaycock
	# Default email; override per-machine in ~/.gitconfig.local (see [include] below)
	email = jaycock.n@gmail.com
	signingKey = ""
[credential]
	helper = store
[color]
	ui = auto
[gpg]
	format = openpgp
	program = gpg
[commit]
	gpgSign = false
[tag]
	forceSignAnnotated = false
[gpg "ssh"]
	program = ssh-keygen
	allowedSignersFile = ""
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[mergetool "nvimdiff"]
	cmd = nvim -d -c 'wincmd l' -c 'norm ]c' \"$LOCAL\" \"$MERGED\" \"$REMOTE\"
# Machine-specific overrides (email, signingKey, etc.). Untracked; missing file is ignored.
# Read last, so anything here wins over the defaults above.
[include]
	path = ~/.gitconfig.local
# Always commit to the dotfiles repo as personal, whatever the machine default is.
# Read after the machine-local include above, so it wins inside ~/.dotfiles.
[includeIf "gitdir:~/.dotfiles/"]
	path = ~/.dotfiles/git/gitconfig-personal
