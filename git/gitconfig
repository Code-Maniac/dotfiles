[init]
	defaultBranch = master
[core]
	editor = nvim
	excludesfile = ~/.gitignore_global
	pager = delta
[merge]
	tool = nvimdiff
	conflictstyle = zdiff3
[mergetool]
	prompt = false
[diff]
	tool = nvimdiff
	# Needed for delta's moved-line highlighting; without it a moved block
	# still reads as one deletion and one addition.
	colorMoved = default
[difftool]
	prompt = true
[difftool "nvimdiff"]
	cmd = nvim -f -d -c \"wincmd l\" -c 'cd \"$GIT_PREFIX\"' \"$LOCAL\" \"$REMOTE\"
# delta only pages "git diff"/"log"/"show". "git d" is still difftool above,
# so side-by-side editing in nvim is unaffected.
[delta]
	navigate = true
	line-numbers = true
	syntax-theme = Dracula
[interactive]
	diffFilter = delta --color-only
[alias]
	d = difftool
	whatadded = log --diff-filter=A --
	l = log --graph
	lgb = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset%n' --abbrev-commit --date=relative --branches
	fl = log --oneline --graph --all --decorate --abbrev-commit
[mergetool "vim-conflicted"]
	cmd = nvim +Conflicted
[user]
	name = Nick Jaycock
	# Work address everywhere by default, on every machine. The dotfiles repo
	# itself still commits as personal - see the includeIf at the bottom.
	email = nick.jaycock@veethree.com
	signingKey = ""
[credential]
	helper = store
[color]
	ui = auto
[gpg]
	format = openpgp
	program = gpg
[commit]
	gpgSign = false
[tag]
	forceSignAnnotated = false
[gpg "ssh"]
	program = ssh-keygen
	allowedSignersFile = ""
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[mergetool "nvimdiff"]
	cmd = nvim -d -c 'wincmd l' -c 'norm ]c' \"$LOCAL\" \"$MERGED\" \"$REMOTE\"
# Machine-specific overrides (email, signingKey, etc.). Untracked; missing file is ignored.
# Read last, so anything here wins over the defaults above.
[include]
	path = ~/.gitconfig.local
# Always commit to the dotfiles repo as personal, whatever the machine default is.
# Read after the machine-local include above, so it wins inside ~/.dotfiles.
[includeIf "gitdir:~/.dotfiles/"]
	path = ~/.dotfiles/git/gitconfig-personal
