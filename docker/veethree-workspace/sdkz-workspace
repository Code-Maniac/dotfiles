#!/usr/bin/env bash
# Point veethree-workspace at a different SDKZ image.
#
# Pulls from sdkz-builder:5000/vtsdk unless given a reference that already has a
# registry or namespace in it, records the choice in .env beside compose.yaml so
# a later plain `docker compose up` keeps using it, and recreates the container.
#
# usage:
#   sdkz-workspace --install <image[:tag]>   pull it and recreate the container
#   sdkz-workspace --update                  re-pull the current image, recreate
#   sdkz-workspace --build <dir> [options]   build the image from the sdkz_docker
#                                            checkout at <dir> instead of pulling,
#                                            and recreate the container
#     --branch <name>                        BRANCH_NAME to west init (master)
#     --sdk-version <x.y.z>                  SDK_VERSION (versionNumber.sh's, -local)
#     --public-release                       PUBLIC_RELEASE=true (default false)
#     --base-image <ref>                     BASE_IMAGE (the Dockerfile's default)
#     --ssh-key <path>                       private key for bitbucket, its .pub
#                                            goes too if present (~/.ssh/id_rsa)
#     --tag <image:tag>                      what to tag the result
#                                            (local/veethree_sdkz:<sdk-version>)
#   sdkz-workspace --list                    images available in the registry
#   sdkz-workspace --tags <image>            tags available for one image
#   sdkz-workspace --current                 what the container is running now
#   sdkz-workspace --start                   start the container as it is
#   sdkz-workspace --attach                  open a shell in the container
#   sdkz-workspace --restore                 swap the previous container back in,
#                                            filesystem and all
#   sdkz-workspace --vnc                     open the container's VNC session
#   --backup                                 with --install/--update/--build: commit
#                                            the old container first, so --restore
#                                            can bring it back. Without it the old
#                                            container is discarded
#   -y                                       skip the confirmation

set -euo pipefail

REGISTRY_HOST=sdkz-builder:5000
NAMESPACE=vtsdk
CONTAINER=veethree-workspace
# The previous container is preserved as a committed image rather than as a kept
# container. A renamed container still carries compose's project and service
# labels, and compose matches containers on those labels rather than on their
# name - so the `compose up --force-recreate` in install() deleted the very
# backup install() had renamed one line earlier, every time. An image is outside
# compose's view entirely. A commit also costs only the container's writable
# layer, since it stacks on the layers the image already has.
BACKUP_IMAGE=veethree-workspace-backup:previous

# What the snapshotted container was built from. A commit's own tag says nothing
# about its origin, so it is recorded here for --restore and --current to show.
ORIGIN_LABEL=sdkz-workspace.origin

# compose publishes both of these on loopback, so the viewer connects to the
# host side rather than into the container.
VNC_ADDR=127.0.0.1:5900
NOVNC_URL=http://127.0.0.1:6080/vnc.html

# Images from --build are tagged under this, which has a slash so resolve_ref
# leaves them alone, and which --update recognises as not pullable.
LOCAL_NAMESPACE=local

HERE=$(cd -- "$(dirname -- "$(readlink -f "$0")")" && pwd)
COMPOSE=$HERE/compose.yaml
ENVFILE=$HERE/.env

die() { printf '%s\n' "$*" >&2; exit 1; }

# The header block, up to the first line that is not a comment - so adding a
# command to it does not mean fixing a line range down here as well.
usage() { sed -n '2,${ /^#/!q; s/^# \{0,1\}//; p; }' "$0"; }

# A tag is a colon in the final path segment - the registry's port colon is not
# one, which is why this looks at ${ref##*/} rather than the whole reference.
resolve_ref() {
    local name=$1 ref
    if [[ $name == */* ]]; then ref=$name; else ref=$REGISTRY_HOST/$NAMESPACE/$name; fi
    [[ ${ref##*/} == *:* ]] || ref=$ref:latest
    printf '%s\n' "$ref"
}

registry_get() {
    curl -sf --max-time 15 "https://$REGISTRY_HOST/v2/$1" ||
        die "sdkz-workspace: could not reach https://$REGISTRY_HOST"
}

list_images() {
    registry_get "_catalog" | python3 -c '
import json, sys
for repo in json.load(sys.stdin)["repositories"]:
    if repo.startswith("'"$NAMESPACE"'/"):
        print(" ", repo.split("/", 1)[1])
'
}

list_tags() {
    [[ $# -ge 1 ]] || die "sdkz-workspace: --tags needs an image name"
    registry_get "$NAMESPACE/$1/tags/list" | python3 -c '
import json, sys
d = json.load(sys.stdin)
print(d["name"] + ":")
print("  " + "  ".join(sorted(d.get("tags") or [])))
'
}

current() {
    docker inspect "$CONTAINER" --format 'running: {{.Config.Image}}   ({{.State.Status}})' 2>/dev/null ||
        { echo "no $CONTAINER container exists"; return; }

    # A restored container was created from a commit, so .Config.Image above is a
    # bare image ID. Image labels come through onto the container, so the origin
    # recorded at snapshot time says what that ID actually is.
    local origin
    origin=$(docker inspect "$CONTAINER" \
        --format "{{index .Config.Labels \"$ORIGIN_LABEL\"}}" 2>/dev/null) || return 0
    [[ -n $origin ]] && echo "  restored snapshot of: $origin"
    return 0
}

# The image a previous run recorded in .env, which is the one compose will use.
# Empty if .env is absent, in which case compose falls back to the default in
# compose.yaml.
env_ref() {
    [[ -f $ENVFILE ]] || return 0
    sed -n 's/^SDKZ_IMAGE=//p' "$ENVFILE" | tail -n1
}

# The tmux socket directory has to exist, owned by us, before the container
# starts. Otherwise docker creates it as root, tmux later replaces it, and the
# container's mount is left pinned to the deleted original - so nothing inside
# can reach the tmux server until the container is restarted.
ensure_tmux_dir() {
    local dir=${TMUX_SOCKET_DIR:-/tmp/tmux-$(id -u)}
    mkdir -p -m 700 "$dir" || die "sdkz-workspace: could not create $dir"
    [[ -O $dir ]] || die "sdkz-workspace: $dir is not owned by you - remove it and start tmux first"
}

# Bring the workspace up without pulling or replacing anything: the image choice
# is whatever the last pull recorded, so this only has to get a container
# running for it. An existing container is started in place rather than
# recreated, which keeps its filesystem; a missing one is created by compose.
# Deliberately no --force-recreate here - that is what the image swap in main()
# is for.
start() {
    local status ref
    ref=$(env_ref)

    if status=$(docker inspect "$CONTAINER" --format '{{.State.Status}}' 2>/dev/null); then
        if [[ $status == running ]]; then
            echo "$CONTAINER is already running"
            current
            return 0
        fi
        ensure_tmux_dir
        echo "starting $CONTAINER"
        docker start "$CONTAINER" >/dev/null
    else
        echo "no $CONTAINER container exists - creating one from:"
        echo "    ${ref:-the default in compose.yaml}"
        ensure_tmux_dir
        if [[ -f $ENVFILE ]]; then
            docker compose -f "$COMPOSE" --env-file "$ENVFILE" up -d
        else
            docker compose -f "$COMPOSE" up -d
        fi
    fi

    echo
    current
    echo "    sdkz-workspace --attach            open a shell in it"
}

# A shell in the running container. zsh is what the dotfiles install puts there,
# but the image ships without it - the account is left on /bin/sh until ./install
# has run - so a fresh container falls back to bash rather than failing.
#
# The -e flags are the same set tmux/docker-split passes: TERM and COLORTERM so
# the shell renders like the rest of the session, TMUX and TMUX_PANE so nvim's
# tmux-navigator inside the container can drive the tmux server on the host.
# exec, so the shell replaces this script and its exit status is the shell's.
attach() {
    docker container inspect "$CONTAINER" >/dev/null 2>&1 ||
        die "sdkz-workspace: there is no $CONTAINER container to attach to"
    [[ $(docker inspect "$CONTAINER" --format '{{.State.Status}}') == running ]] ||
        die "sdkz-workspace: $CONTAINER is not running - start it with 'sdkz-workspace --start'"

    local s shell=""
    for s in /bin/zsh /bin/bash /bin/sh; do
        if docker exec "$CONTAINER" test -x "$s" 2>/dev/null; then shell=$s; break; fi
    done
    [[ -n $shell ]] || die "sdkz-workspace: no shell found in $CONTAINER"

    exec docker exec -it -e TERM -e COLORTERM -e TMUX -e TMUX_PANE \
        "$CONTAINER" "$shell"
}

# Commit the current container's filesystem to $BACKUP_IMAGE so it survives the
# recreate that follows. Everything written inside the container comes with it -
# packages installed by hand, build trees, anything outside the host mounts.
#
# Stopping first is not optional in either caller: the container holds ports 5900
# and 6080, which the replacement needs. It also means the commit is taken of a
# quiescent filesystem rather than a running one.
#
# No container to snapshot is a success, not a failure - a first install has
# nothing to preserve.
snapshot() {
    docker container inspect "$CONTAINER" >/dev/null 2>&1 || return 0

    local origin
    origin=$(docker inspect "$CONTAINER" --format '{{.Config.Image}}')

    echo "stopping $CONTAINER"
    docker stop "$CONTAINER" >/dev/null
    echo "committing its filesystem to $BACKUP_IMAGE - this takes a moment"
    docker commit --change "LABEL $ORIGIN_LABEL=\"$origin\"" \
        "$CONTAINER" "$BACKUP_IMAGE" >/dev/null ||
        die "sdkz-workspace: could not commit $CONTAINER - nothing has been changed"
}

# Bring back the snapshot taken when the container was last replaced. Because the
# filesystem now lives in an image, this goes through compose like any other
# image change - the old rename-and-start dance is gone, and so is the reason it
# had to avoid --force-recreate.
#
# The swap stays reversible: whatever is running is committed over $BACKUP_IMAGE
# on the way past, so --restore again returns to it.
restore() {
    local assume_yes=$1 target origin

    docker image inspect "$BACKUP_IMAGE" >/dev/null 2>&1 ||
        die "sdkz-workspace: there is no $BACKUP_IMAGE snapshot to restore"

    # Pinned by ID before anything else, because snapshot() below is about to
    # move that tag onto the container being replaced.
    target=$(docker image inspect "$BACKUP_IMAGE" --format '{{.Id}}')
    origin=$(docker image inspect "$BACKUP_IMAGE" \
        --format "{{index .Config.Labels \"$ORIGIN_LABEL\"}}" 2>/dev/null) || origin=""

    if (( ! assume_yes )); then
        echo "This replaces the $CONTAINER container with the snapshot taken when it"
        echo "was last replaced, originally built from:"
        echo "    ${origin:-unrecorded}"
        echo
        echo "That container's filesystem comes back with it, not just the image."
        echo
        echo "Whatever is running now is committed over $BACKUP_IMAGE in its place, so"
        echo "this is reversible - run --restore again to swap back."
        echo
        read -r -p "continue? [y/N] " reply
        [[ $reply == [yY]* ]] || { echo "aborted"; return 1; }
    fi

    snapshot

    # The ID, not the tag: $BACKUP_IMAGE now points at the container that was
    # just replaced, so recording the tag would leave a later plain
    # `docker compose up` recreating this container from the wrong snapshot.
    printf 'SDKZ_IMAGE=%s\n' "$target" > "$ENVFILE"

    ensure_tmux_dir
    docker compose -f "$COMPOSE" --env-file "$ENVFILE" up -d --force-recreate

    echo
    current
    echo "the container this replaced is kept as $BACKUP_IMAGE"
    echo "the dotfiles are already installed in this one - no need to run ./install"
}

# $BROWSER first so a deliberate choice wins, then the desktop's default, then
# whatever is actually installed. Returns non-zero if nothing can open a URL.
open_browser() {
    local url=$1 b
    for b in ${BROWSER:-} xdg-open gio firefox chromium chromium-browser \
             google-chrome brave-browser epiphany falkon; do
        command -v "$b" >/dev/null 2>&1 || continue
        if [[ $b == gio ]]; then
            setsid "$b" open "$url" >/dev/null 2>&1 &
        else
            setsid "$b" "$url" >/dev/null 2>&1 &
        fi
        printf '%s\n' "$b"
        return 0
    done
    return 1
}

# The container's entrypoint already runs Xvfb, x11vnc and noVNC, so this only
# has to attach viewers. Both routes reach the same x11vnc, and it runs without
# -shared, so a second client disconnects the first - hence the warning when
# both open. Everything is detached so the shell comes straight back.
vnc() {
    docker container inspect "$CONTAINER" >/dev/null 2>&1 ||
        die "sdkz-workspace: there is no $CONTAINER container to connect to"
    [[ $(docker inspect "$CONTAINER" --format '{{.State.Status}}') == running ]] ||
        die "sdkz-workspace: $CONTAINER is not running - start it with 'docker start $CONTAINER'"

    local viewer native="" browser=""

    for viewer in vncviewer gvncviewer vinagre remmina; do
        command -v "$viewer" >/dev/null 2>&1 || continue
        native=$viewer
        echo "opening $VNC_ADDR with $viewer"
        if [[ $viewer == remmina ]]; then
            setsid "$viewer" -c "vnc://$VNC_ADDR" >/dev/null 2>&1 &
        else
            setsid "$viewer" "$VNC_ADDR" >/dev/null 2>&1 &
        fi
        break
    done

    if browser=$(open_browser "$NOVNC_URL"); then
        echo "opening $NOVNC_URL with $browser"
    elif [[ -z $native ]]; then
        die "sdkz-workspace: nothing available to open a VNC session.
    install a viewer with 'sudo dnf install tigervnc', or browse to $NOVNC_URL"
    else
        echo "no web browser found - native viewer only"
    fi

    if [[ -n $native && -n $browser ]]; then
        echo
        echo "NOTE: x11vnc runs without -shared, so these two will disconnect each"
        echo "      other. Use one and close the other, or add -shared to x11vnc in"
        echo "      the image entrypoint to allow both at once."
    fi

    [[ -n $native ]] || echo "    for a native viewer:  sudo dnf install tigervnc"
}

# Set from the --build options in main(), with the defaults filled in there so
# the confirmation can show what is actually going to be built.
BUILD_CONTEXT=""
BUILD_BRANCH=""
BUILD_SDK_VERSION=""
BUILD_PUBLIC_RELEASE=""
BUILD_BASE_IMAGE=""
BUILD_SSH_KEY=""

# The keys go to the build as a BuildKit secret, which the Dockerfile mounts at
# /tmp/ssh_keys.tar.gz for the west step alone and shreds afterwards. The
# tarball on this side is removed on any exit, a failed or interrupted build
# included.
SSH_TARBALL=""
cleanup_ssh_tarball() { [[ -n $SSH_TARBALL ]] && rm -f -- "$SSH_TARBALL"; return 0; }

build_image() {
    local ref=$1 key_dir key_name
    local -a key_files args

    key_dir=$(dirname -- "$BUILD_SSH_KEY")
    key_name=$(basename -- "$BUILD_SSH_KEY")
    key_files=("$key_name")
    [[ -f $BUILD_SSH_KEY.pub ]] && key_files+=("$key_name.pub")

    trap cleanup_ssh_tarball EXIT
    trap 'exit 130' INT TERM
    SSH_TARBALL=$(mktemp --suffix=.tar.gz /tmp/sdkz-ssh-keys.XXXXXX)
    tar czf "$SSH_TARBALL" -C "$key_dir" "${key_files[@]}" ||
        die "sdkz-workspace: could not archive $BUILD_SSH_KEY"

    args=(
        --secret "id=ssh_keys,src=$SSH_TARBALL"
        --build-arg "BRANCH_NAME=$BUILD_BRANCH"
        --build-arg "SDK_VERSION=$BUILD_SDK_VERSION"
        --build-arg "PUBLIC_RELEASE=$BUILD_PUBLIC_RELEASE"
        # A new value every time, so west init/update always re-runs rather than
        # coming back from the cache with whatever the branch held last time.
        --build-arg "CACHEBUST=$(date +%s)"
        -f "$BUILD_CONTEXT/Dockerfile"
        -t "$ref"
    )
    [[ -n $BUILD_BASE_IMAGE ]] && args+=(--build-arg "BASE_IMAGE=$BUILD_BASE_IMAGE")

    local status=0
    DOCKER_BUILDKIT=1 docker build "${args[@]}" "$BUILD_CONTEXT" || status=$?
    cleanup_ssh_tarball
    SSH_TARBALL=""
    return "$status"
}

# Get an image and recreate the container from it. $3 is how: install and update
# pull, and differ only in wording - --update comes through here with the
# reference the last install recorded, so a re-pull and a switch of image follow
# exactly the same path. build builds $2 from the sdkz_docker checkout instead.
install() {
    local assume_yes=$1 name=$2 mode=${3:-install} backup=${4:-0} ref bare

    ref=$(resolve_ref "$name")

    # The plain image name, for the tag hint if the pull fails. The registry and
    # namespace come off first, so this is right for a full reference as well -
    # ${name%%:*} on one of those would stop at the registry's port colon.
    bare=${ref##*/}
    bare=${bare%%:*}

    if (( ! assume_yes )); then
        case $mode in
            update)
                echo "This re-pulls the image the $CONTAINER container is running and"
                echo "recreates the container from the fresh copy:"
                echo "    $ref"
                ;;
            build)
                echo "This builds an image from $BUILD_CONTEXT and replaces the"
                echo "$CONTAINER container with one built from it:"
                echo "    $ref"
                echo "        BRANCH_NAME=$BUILD_BRANCH"
                echo "        SDK_VERSION=$BUILD_SDK_VERSION"
                echo "        PUBLIC_RELEASE=$BUILD_PUBLIC_RELEASE"
                echo "        BASE_IMAGE=${BUILD_BASE_IMAGE:-"the Dockerfile's default"}"
                echo "        ssh key: $BUILD_SSH_KEY"
                ;;
            *)
                echo "This replaces the $CONTAINER container with one built from:"
                echo "    $ref"
                ;;
        esac
        echo
        if (( backup )); then
            echo "The current container's filesystem is committed to $BACKUP_IMAGE first,"
            echo "so nothing in it is lost - bring the whole thing back with:"
            echo "    sdkz-workspace --restore"
        else
            echo "The current container is discarded without a snapshot - anything"
            echo "written inside it outside the host mounts is lost. Add --backup to keep it."
        fi
        echo
        echo "These are mounted from the host and carry over regardless:"
        echo "    the apps folder, ~/.ssh, ~/.claude, ~/.dotfiles, the tmux socket"
        if (( backup )) && docker image inspect "$BACKUP_IMAGE" >/dev/null 2>&1; then
            echo
            echo "NOTE: only one snapshot is kept - the existing $BACKUP_IMAGE"
            echo "      is replaced, and whatever it holds is no longer restorable."
        fi
        echo
        read -r -p "continue? [y/N] " reply
        [[ $reply == [yY]* ]] || { echo "aborted"; return 1; }
    fi

    if [[ $mode == build ]]; then
        build_image "$ref" || die "sdkz-workspace: build failed - nothing has been changed"
    elif ! docker pull "$ref"; then
        echo >&2
        echo "sdkz-workspace: pull failed. Tags available for that image:" >&2
        list_tags "$bare" >&2 || true
        return 1
    fi

    # Snapshot before .env is touched, so a failed commit leaves the recorded
    # image still matching the container that is actually there.
    #
    # The old container is not kept alongside the new one. Compose will not adopt
    # a container it did not create, and renaming the old one out of the way does
    # not help: the rename leaves compose's project and service labels on it,
    # compose matches on those rather than on the name, and the --force-recreate
    # below then deletes it. Committing puts the filesystem somewhere compose
    # cannot reach, and compose removes the container itself.
    #
    # Without --backup there is nothing to do here: --force-recreate stops and
    # removes the old container itself before the new one takes its ports.
    (( backup )) && snapshot

    printf 'SDKZ_IMAGE=%s\n' "$ref" > "$ENVFILE"

    ensure_tmux_dir
    docker compose -f "$COMPOSE" --env-file "$ENVFILE" up -d --force-recreate

    echo
    current
    if (( ! backup )); then
        echo "previous container discarded (no --backup)"
    elif docker image inspect "$BACKUP_IMAGE" >/dev/null 2>&1; then
        echo "previous container kept as the image $BACKUP_IMAGE"
        echo "    sdkz-workspace --restore       bring it back, filesystem and all"
        echo "    docker cp is not needed        --restore recreates the whole thing"
        echo "    docker rmi $BACKUP_IMAGE"
        echo "                                   reclaim its disk when done"
    fi
    echo "run ./install inside the new one to relink the dotfiles and install its packages:"
    echo "    docker exec -it $CONTAINER zsh -lc '~/.dotfiles/install'"
}

main() {
    local assume_yes=0 image="" do_restore=0 do_install=0 do_update=0 do_build=0 backup=0
    local build_opts=0 tag=""
    while (( $# )); do
        case $1 in
            -y|--yes)   assume_yes=1 ;;
            --backup)   backup=1 ;;
            --list)     list_images; return 0 ;;
            --tags)     shift; list_tags "$@"; return 0 ;;
            --current)  current; return 0 ;;
            --start)    start; return 0 ;;
            --attach)   attach; return 0 ;;  # execs, so this does not come back
            --vnc)      vnc; return 0 ;;
            --restore)  do_restore=1 ;;
            --update)   do_update=1 ;;
            --build)
                do_build=1
                [[ $# -ge 2 && $2 != -* ]] ||
                    die "sdkz-workspace: --build needs the path to the sdkz_docker checkout"
                BUILD_CONTEXT=$2
                shift
                ;;
            --install)
                do_install=1
                [[ $# -ge 2 ]] || die "sdkz-workspace: --install needs an image name"
                image=$2
                shift
                ;;
            --branch|--sdk-version|--base-image|--ssh-key|--tag)
                [[ $# -ge 2 ]] || die "sdkz-workspace: $1 needs a value"
                case $1 in
                    --branch)      BUILD_BRANCH=$2 ;;
                    --sdk-version) BUILD_SDK_VERSION=$2 ;;
                    --base-image)  BUILD_BASE_IMAGE=$2 ;;
                    --ssh-key)     BUILD_SSH_KEY=$2 ;;
                    --tag)         tag=$2 ;;
                esac
                build_opts=1
                shift
                ;;
            --public-release) BUILD_PUBLIC_RELEASE=true; build_opts=1 ;;
            -h|--help)  usage; return 0 ;;
            -*)         die "sdkz-workspace: unknown option $1" ;;
            # An image used to be given on its own. Say where it went rather than
            # quietly doing something with it.
            *)          die "sdkz-workspace: an image goes with --install now:
    sdkz-workspace --install $1" ;;
        esac
        shift
    done

    (( do_install + do_update + do_restore + do_build <= 1 )) ||
        die "sdkz-workspace: --install, --update, --build and --restore are one at a time"

    (( build_opts && ! do_build )) &&
        die "sdkz-workspace: --branch, --sdk-version, --public-release,
    --base-image, --ssh-key and --tag go with --build"

    # --restore always commits what it replaces, to stay reversible, so --backup
    # has nothing to switch on there.
    (( do_restore && backup )) &&
        die "sdkz-workspace: --backup goes with --install, --update or --build - --restore always keeps one"

    if (( do_restore )); then
        restore "$assume_yes"
        return
    fi

    # --update is --install against the reference the last install recorded, so
    # it re-pulls the same name:tag and picks up whatever the registry has now.
    if (( do_update )); then
        image=$(env_ref)
        [[ -n $image ]] ||
            die "sdkz-workspace: no image recorded in $ENVFILE - install one with
    sdkz-workspace --install <image>"
        [[ $image == "$LOCAL_NAMESPACE"/* ]] &&
            die "sdkz-workspace: $image was built here, not pulled - rebuild it with
    sdkz-workspace --build"
        install "$assume_yes" "$image" update "$backup"
        return
    fi

    if (( do_build )); then
        [[ -d $BUILD_CONTEXT ]] || die "sdkz-workspace: no such directory $BUILD_CONTEXT"
        BUILD_CONTEXT=$(cd -- "$BUILD_CONTEXT" && pwd)
        [[ -f $BUILD_CONTEXT/Dockerfile ]] ||
            die "sdkz-workspace: no Dockerfile in $BUILD_CONTEXT - is it the sdkz_docker checkout?"
        BUILD_BRANCH=${BUILD_BRANCH:-master}
        BUILD_PUBLIC_RELEASE=${BUILD_PUBLIC_RELEASE:-false}
        if [[ -z $BUILD_SDK_VERSION ]]; then
            BUILD_SDK_VERSION=$(source "$BUILD_CONTEXT/versionNumber.sh" && printf '%s' "$SDKZ_VERSION") &&
                [[ -n $BUILD_SDK_VERSION ]] ||
                die "sdkz-workspace: could not read SDKZ_VERSION from $BUILD_CONTEXT/versionNumber.sh
    - give one with --sdk-version"
            BUILD_SDK_VERSION+=-local
        fi

        BUILD_SSH_KEY=${BUILD_SSH_KEY:-$HOME/.ssh/id_rsa}
        [[ -r $BUILD_SSH_KEY ]] || die "sdkz-workspace: cannot read $BUILD_SSH_KEY"
        # Nothing in the build tells ssh which key to use, so it only tries the
        # default identity names - any other name is carried in and never offered.
        case $(basename -- "$BUILD_SSH_KEY") in
            id_rsa|id_ecdsa|id_ecdsa_sk|id_ed25519|id_ed25519_sk|id_xmss|id_dsa) ;;
            *) die "sdkz-workspace: ssh in the build only tries the default key names
    (id_rsa, id_ed25519, ...) - $BUILD_SSH_KEY would never be offered" ;;
        esac

        install "$assume_yes" "${tag:-$LOCAL_NAMESPACE/veethree_sdkz:$BUILD_SDK_VERSION}" build "$backup"
        return
    fi

    (( do_install )) || { usage; return 1; }
    install "$assume_yes" "$image" install "$backup"
}

main "$@"
